{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "provider": {
    "local-direct": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local LLM — Direct",
      "options": { "baseURL": "http://127.0.0.1:8081/v1", "apiKey": "local" },
      "models": {
        "local-llm": { "name": "Local LLM", "limit": { "context": 16384, "output": 2048 } }
      }
    },
    "local-wrapped": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local LLM — Tool Repair",
      "options": { "baseURL": "http://127.0.0.1:8090/v1", "apiKey": "local" },
      "models": {
        "local-llm": { "name": "Local LLM", "limit": { "context": 16384, "output": 2048 } }
      }
    },
    "turbofieldfare": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TurboFieldfare (Gemma 4 26B)",
      "options": { "baseURL": "http://127.0.0.1:8081/v1", "apiKey": "local" },
      "models": {
        "gemma-4-26b-a4b-it": { "name": "Gemma 4 26B-A4B IT", "limit": { "context": 16384, "output": 4096 } }
      }
    }
  }
}
