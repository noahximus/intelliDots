#!/usr/bin/env bash
set -euo pipefail

requested_version=""
force=false
run_install=true
run_allow=true

usage() {
  cat <<'EOF'
Usage:
  node-here [--node VERSION] [--force] [--no-install] [--no-allow]

Creates a project .nvmrc, writes a managed .envrc for NVM and direnv, installs
the selected Node version when needed, and runs direnv allow.

Options:
  --node VERSION  Node version to pin. Default: the NVM default, current Node,
                  or DEFAULT_NODE_VERSION (22.7.0).
  --force         Replace an existing .nvmrc and an .envrc not managed by this helper.
  --no-install    Do not install or activate the selected Node version now.
  --no-allow      Create files but skip direnv allow.

Examples:
  node-here
  node-here --node 22.7.0
  node-here --node 20 --no-install
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h)
      usage
      exit 0
      ;;
    --node)
      shift
      [[ $# -gt 0 ]] || { echo "--node requires a version." >&2; exit 2; }
      requested_version="$1"
      ;;
    --node=*) requested_version="${1#*=}" ;;
    --force) force=true ;;
    --no-install) run_install=false ;;
    --no-allow) run_allow=false ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

load_nvm() {
  command -v nvm >/dev/null 2>&1 && return 0
  export NVM_DIR="${NVM_DIR:-${XDG_CONFIG_HOME:-${HOME}/.config}/nvm}"
  command -v brew >/dev/null 2>&1 || return 1
  local nvm_prefix
  nvm_prefix="$(brew --prefix nvm 2>/dev/null)" || return 1
  [[ -s "${nvm_prefix}/nvm.sh" ]] || return 1
  # shellcheck source=/dev/null
  . "${nvm_prefix}/nvm.sh"
}

if [[ -z "${requested_version}" ]]; then
  if load_nvm; then
    requested_version="$(nvm version default 2>/dev/null || true)"
    [[ "${requested_version}" != "N/A" ]] || requested_version=""
  fi
  if [[ -z "${requested_version}" ]] && command -v node >/dev/null 2>&1; then
    requested_version="$(node --version)"
  fi
  requested_version="${requested_version:-${DEFAULT_NODE_VERSION:-22.7.0}}"
fi
requested_version="${requested_version#v}"

if [[ -f .nvmrc ]]; then
  existing_version="$(sed -n '1p' .nvmrc | tr -d '[:space:]')"
  if [[ "${existing_version#v}" == "${requested_version}" ]]; then
    echo "Existing .nvmrc already selects ${existing_version}."
  elif [[ "${force}" == true ]]; then
    printf '%s\n' "${requested_version}" >.nvmrc
    echo "Replaced .nvmrc with Node ${requested_version}."
  else
    echo ".nvmrc already selects ${existing_version}; requested ${requested_version}." >&2
    echo "Rerun with --force to replace it." >&2
    exit 1
  fi
elif [[ -e .nvmrc ]]; then
  echo ".nvmrc exists but is not a regular file." >&2
  exit 1
else
  printf '%s\n' "${requested_version}" >.nvmrc
  echo "Created .nvmrc for Node ${requested_version}."
fi

envrc_content='# Generated by node-here.
export NVM_DIR="${NVM_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/nvm}"
if ! command -v nvm >/dev/null 2>&1; then
  nvm_homebrew_prefix="$(brew --prefix nvm 2>/dev/null)"
  source "${nvm_homebrew_prefix}/nvm.sh"
  unset nvm_homebrew_prefix
fi
nvm use --silent
'

if [[ -e .envrc ]]; then
  if grep -qx '# Generated by node-here\.' .envrc; then
    printf '%s' "${envrc_content}" >.envrc
    echo "Updated existing node-here .envrc."
  elif [[ "${force}" == true ]]; then
    printf '%s' "${envrc_content}" >.envrc
    echo "Replaced existing .envrc."
  else
    echo ".envrc already exists and was not created by node-here." >&2
    echo "Review it manually, or rerun with --force to replace it." >&2
    exit 1
  fi
else
  printf '%s' "${envrc_content}" >.envrc
  echo "Created .envrc for NVM and direnv."
fi

if [[ "${run_install}" == true ]]; then
  load_nvm || { echo "NVM is unavailable. Install it or rerun with --no-install." >&2; exit 1; }
  if [[ "$(nvm version "${requested_version}" 2>/dev/null)" == "N/A" ]]; then
    nvm install "${requested_version}"
  fi
  nvm use "${requested_version}"
fi

if [[ "${run_allow}" == true ]]; then
  command -v direnv >/dev/null 2>&1 || { echo "direnv is unavailable. Install it, then run: direnv allow" >&2; exit 1; }
  direnv allow "${PWD}"
  echo "Allowed direnv for ${PWD}."
fi

echo "Done. Re-enter this folder, or run: direnv reload"
