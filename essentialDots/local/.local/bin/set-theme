#!/usr/bin/env python3

import argparse
import os
import re
import subprocess
from pathlib import Path
from typing import List, Optional


THEMES = {
    "tokyonight": {
        "dark": {
            "nvim": {"colorscheme": "tokyonight", "style": "moon"},
            "superfile": {"theme": "tokyonight", "transparent_background": True},
            "fzf": "bg+:-1,bg:-1,spinner:#7aa2f7,hl:#7dcfff,fg:#c0caf5,header:#7aa2f7,info:#bb9af7,pointer:#7dcfff,marker:#9ece6a,fg+:#c0caf5,prompt:#bb9af7,hl+:#7dcfff",
