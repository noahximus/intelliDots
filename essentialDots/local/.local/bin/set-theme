            "nvim": {"colorscheme": "habamax", "style": "day"},
            "superfile": {"theme": "catppuccin-latte", "transparent_background": False},
            "fzf": "bg+:#eeeeee,bg:#ffffff,spinner:#875f00,hl:#005f87,fg:#303030,header:#875f00,info:#5f5f00,pointer:#875f00,marker:#5f8700,fg+:#000000,prompt:#875f00,hl+:#005f87",
            "tmux": {
                "status-style": "fg=colour238,bg=colour255",
                "window-status-current-style": "fg=colour94,bg=colour253,bold",
                "pane-border-style": "fg=colour250",
                "pane-active-border-style": "fg=colour94",
                "message-style": "fg=colour238,bg=colour253",
            },
        },
    },
}

APP_ALIASES = {
    "all": ("nvim", "tmux", "zsh", "superfile"),
    "editor": ("nvim",),
    "fzf": ("zsh",),
    "neovim": ("nvim",),
    "nvim": ("nvim",),
    "shell": ("zsh",),
    "spf": ("superfile",),
    "superfile": ("superfile",),
    "tmux": ("tmux",),
    "zsh": ("zsh",),
}


def config_home() -> Path:
    return Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))


def write_text(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")


def update_nvim(theme: str, mode: str) -> None:
    path = config_home() / "nvim/lua/plugins/colorscheme.lua"
    settings = THEMES[theme][mode]["nvim"]
    content = f"""local colorscheme = "{settings["colorscheme"]}"
local tokyonight_style = "{settings["style"]}"

return {{
  {{
    "LazyVim/LazyVim",
    opts = {{
      colorscheme = colorscheme,
    }},
  }},

  {{
    "folke/tokyonight.nvim",
    opts = {{
      style = tokyonight_style,
      transparent = true,
      styles = {{
        sidebars = "transparent",
        floats = "transparent",
      }},
    }},
  }},

  {{
    "rcarriga/nvim-notify",
    opts = {{
      background_colour = "#000000",
    }},
  }},
}}
"""
    write_text(path, content)


def update_tmux(theme: str, mode: str) -> None:
    path = config_home() / "tmux/theme.conf"
    options = THEMES[theme][mode]["tmux"]
    lines = [
        f"# Generated by set-theme. Current theme: {theme} {mode}",
        f"set -g @current_theme '{theme}'",
        f"set -g @current_theme_mode '{mode}'",
    ]
    lines.extend(f"set -g {key} {value}" for key, value in options.items())
    write_text(path, "\n".join(lines) + "\n")

    if os.environ.get("TMUX"):
        subprocess.run(["tmux", "source-file", str(path)], check=False)


def update_zsh(theme: str, mode: str) -> None:
    path = config_home() / "zsh/apps/themerc"
    fzf = THEMES[theme][mode]["fzf"]
    content = f"""#!/usr/bin/env zsh
# Generated by set-theme.
export CURRENT_THEME="{theme}"
export CURRENT_THEME_MODE="{mode}"
export FZF_DEFAULT_OPTS="${{FZF_DEFAULT_OPTS:-}} --color={fzf}"
"""
    write_text(path, content)


def replace_toml_value(content: str, key: str, value: str) -> str:
    pattern = rf'^({re.escape(key)}\s*=\s*).*$'
    replacement = rf'\1{value}'
    updated, count = re.subn(pattern, replacement, content, count=1, flags=re.MULTILINE)
    if count:
        return updated
    return content.rstrip() + f"\n{key} = {value}\n"


def update_superfile(theme: str, mode: str) -> None:
    path = config_home() / "superfile/config.toml"
    settings = THEMES[theme][mode]["superfile"]
    content = path.read_text(encoding="utf-8") if path.exists() else ""
    content = replace_toml_value(content, "theme", f'"{settings["theme"]}"')
    content = replace_toml_value(
        content,
        "transparent_background",
        "true" if settings["transparent_background"] else "false",
    )
    write_text(path, content)


def current_mode() -> str:
    path = config_home() / "zsh/apps/themerc"
    if not path.exists():
        return "dark"
    match = re.search(r'CURRENT_THEME_MODE="(dark|light)"', path.read_text(encoding="utf-8"))
    return match.group(1) if match else "dark"


def resolve_apps(apps: Optional[List[str]]) -> List[str]:
    selected = apps or ["all"]
    resolved: List[str] = []
    for app in selected:
        for canonical in APP_ALIASES[app]:
            if canonical not in resolved:
                resolved.append(canonical)
    return resolved


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Switch Neovim, tmux, fzf, and Superfile theme settings.")
    parser.add_argument("theme", nargs="?", choices=sorted(THEMES), default="tokyonight")
    parser.add_argument("mode", nargs="?", choices=("dark", "light"), default=None)
    parser.add_argument(
        "--app",
        action="append",
        choices=sorted(APP_ALIASES),
        help="only update one app; repeat for multiple apps. Default: all",
    )
    parser.add_argument("--toggle", action="store_true", help="toggle between dark and light mode")
    parser.add_argument("--list", action="store_true", help="list available themes")
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    if args.list:
        for theme in sorted(THEMES):
            print(theme)
        return

    mode = args.mode or "dark"
    if args.toggle:
        mode = "light" if current_mode() == "dark" else "dark"

    apps = resolve_apps(args.app)
    if "nvim" in apps:
        update_nvim(args.theme, mode)
    if "tmux" in apps:
        update_tmux(args.theme, mode)
    if "zsh" in apps:
        update_zsh(args.theme, mode)
    if "superfile" in apps:
        update_superfile(args.theme, mode)

    app_label = "all apps" if apps == list(APP_ALIASES["all"]) else ", ".join(apps)
    print(
        f"Set theme to {args.theme} {mode} for {app_label}. "
        "Restart your shell; restart Neovim and Superfile to see app changes."
    )


if __name__ == "__main__":
    main()
