                "pane-border-style": "fg=colour238",
                "pane-active-border-style": "fg=colour117",
                "message-style": "fg=colour189,bg=colour238",
            },
        },
        "light": {
            "nvim": {"colorscheme": "tokyonight", "style": "day"},
            "superfile": {"theme": "catppuccin-latte", "transparent_background": False},
            "fzf": "bg+:#e9e9ec,bg:#d5d6db,spinner:#2e7de9,hl:#007197,fg:#3760bf,header:#2e7de9,info:#9854f1,pointer:#007197,marker:#587539,fg+:#3760bf,prompt:#9854f1,hl+:#007197",
            "tmux": {
                "status-style": "fg=colour24,bg=colour254",
                "window-status-current-style": "fg=colour25,bg=colour250,bold",
