            },
        },
    },
    "habamax": {
        "dark": {
            "nvim": {"colorscheme": "habamax", "style": "moon"},
            "superfile": {"theme": "monokai", "transparent_background": True},
            "fzf": "bg+:#303030,bg:#1c1c1c,spinner:#ffd75f,hl:#87afd7,fg:#d0d0d0,header:#ffd75f,info:#afaf87,pointer:#ffd75f,marker:#afd75f,fg+:#ffffff,prompt:#ffd75f,hl+:#87afd7",
            "tmux": {
