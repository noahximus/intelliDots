#!/usr/bin/env bash
set -euo pipefail

python_bin="python3"
force=false
run_allow=true

usage() {
  cat <<'EOF'
Usage:
  venv-here [--python PYTHON] [--force] [--no-allow]

Creates a .venv in the current directory, names the prompt after the folder,
writes an .envrc for direnv, and runs direnv allow.

Options:
  --python PYTHON  Python executable to use. Default: python3
  --force          Replace an existing .envrc managed by this helper
  --no-allow       Create files but skip direnv allow

Examples:
  venv-here
  venv-here --python python3.12
  venv-here --python "$HOME/.config/.pyenv/versions/3.12.12/bin/python"
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --help|-h)
      usage
      exit 0
      ;;
    --python)
      if [ "$#" -lt 2 ]; then
        printf '%s\n' '--python requires a value' >&2
        exit 2
      fi
      python_bin="$2"
      shift 2
      ;;
    --force)
      force=true
      shift
      ;;
    --no-allow)
      run_allow=false
      shift
      ;;
    *)
      printf 'Unknown option: %s\n\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

project_dir="${PWD}"
project_name="$(basename "${project_dir}")"

if [ -z "${project_name}" ] || [ "${project_name}" = "/" ]; then
  project_name="venv"
fi

if ! command -v "${python_bin}" >/dev/null 2>&1; then
  printf 'Python executable not found: %s\n' "${python_bin}" >&2
  exit 1
fi

if [ -e ".venv" ]; then
  printf '.venv already exists in %s\n' "${project_dir}" >&2
else
  "${python_bin}" -m venv --prompt="${project_name}" .venv
  printf 'Created .venv with prompt: %s\n' "${project_name}"
fi

envrc_content='# Generated by venv-here.
source .venv/bin/activate
'

if [ -e ".envrc" ]; then
  if grep -qx '# Generated by venv-here\.' .envrc; then
    printf '%s' "${envrc_content}" > .envrc
    printf 'Updated existing venv-here .envrc\n'
  elif [ "${force}" = true ]; then
    printf '%s' "${envrc_content}" > .envrc
    printf 'Replaced existing .envrc\n'
  else
    printf '.envrc already exists and was not created by venv-here.\n' >&2
    printf 'Review it manually, or rerun with --force to replace it.\n' >&2
    exit 1
  fi
else
  printf '%s' "${envrc_content}" > .envrc
  printf 'Created .envrc for direnv\n'
fi

if [ "${run_allow}" = true ]; then
  if command -v direnv >/dev/null 2>&1; then
    direnv allow "${project_dir}"
    printf 'Allowed direnv for %s\n' "${project_dir}"
  else
    printf 'direnv is not installed or not on PATH. Run direnv allow after installing it.\n' >&2
    exit 1
  fi
fi

printf 'Done. Re-enter this folder, or run: direnv reload\n'
