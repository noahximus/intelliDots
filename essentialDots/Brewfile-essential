tap "felixkratz/formulae" # Extra formulae used by macOS UI tools like borders.
tap "nikitabobko/tap" # Official tap for the AeroSpace window manager cask.

brew "borders" # Draws window borders that pair well with AeroSpace.
brew "cmake" # Build system generator needed by some developer tools and native packages.
brew "direnv" # Automatically loads per-project environment variables.
brew "eza" # Modern replacement for ls with icons, colors, and Git status.
brew "fd" # Fast, friendly file finder used by shell workflows and virtualenv discovery.
brew "fzf" # Fuzzy finder used by shell, Git, and editor workflows.
brew "gh" # GitHub CLI for repositories, pull requests, issues, and auth.
brew "git" # Version control system used by these dotfiles and most dev work.
brew "node" # JavaScript runtime used by command-line development workflows.
brew "nvm" # Node.js version manager loaded by the zsh config.
brew "openssl@3" # TLS library used when building Python versions with pyenv.
brew "powerlevel10k" # Zsh prompt theme used by the shell config.
brew "pipx" # Installs Python CLI apps in isolated virtual environments.
brew "pyenv" # Python version manager used to install modern Python runtimes.
brew "readline" # Command-line editing library used by pyenv-built Python.
brew "ripgrep" # Very fast text search used by shell and repository workflows.
brew "sqlite" # SQLite support used by pyenv-built Python.
brew "stow" # Symlink manager used to install these dotfiles.
brew "superfile" # Terminal file manager.
brew "tmux" # Terminal multiplexer configured by the tmux dotfiles.
brew "xz" # Compression library used when building Python versions with pyenv.
brew "zsh-autosuggestions" # Zsh plugin that suggests commands from shell history.
brew "zsh-fast-syntax-highlighting" # Zsh plugin that highlights commands as you type.

cask "aerospace" # Tiling window manager for macOS.
cask "chatgpt" # OpenAI's official ChatGPT desktop app.
cask "claude" # Anthropic's official Claude desktop app.
cask "claude-code" # Anthropic's official Claude Code CLI app.
cask "discord" # Voice, chat, and community messaging app.
cask "docker-desktop" # Docker Desktop for containers and local development services.
cask "font-meslo-for-powerlevel10k" # MesloLGS NF font used by the Powerlevel10k prompt.
cask "google-chrome" # Web browser.
cask "google-drive" # Google Drive sync client and Docs/Sheets/Slides shortcuts.
# cask "messenger" # Facebook Messenger desktop messaging app.
cask "microsoft-office" # Microsoft Word, Excel, PowerPoint, Outlook, and Office apps.
cask "obsidian" # Markdown knowledge base and note-taking app.
cask "paragon-ntfs" # Read/write support for NTFS drives on macOS.
cask "spotify" # Music and podcast streaming app.
cask "tg-pro" # Temperature monitoring, fan control, and Mac hardware diagnostics.
cask "viber" # Viber desktop messaging and calling app.
cask "whatsapp" # WhatsApp desktop messaging app.
