# default layout (can be bsp, stack or float)
yabai -m config layout bsp

# My custom space names for my 3 monitor setup. These names are used in some of my scripts.
yabai -m space 1 --label priority 
yabai -m space 2 --label priorityValidation
yabai -m space 3 --label priorityReasearch
yabai -m space 4 --label messaging
yabai -m space 5 --label webBrowsingSocialMedia
yabai -m space 6 --label webBrowsingEntertainment
yabai -m space 7 --label notes
yabai -m space 8 --label eight
yabai -m space 9 --label nine

# new window spawns to the right if vertical split, or bottom if horizontal split
yabai -m config window_placement second_child

# padding set to 12px
yabai -m config top_padding 12
yabai -m config bottom_padding 12
yabai -m config left_padding 12
yabai -m config right_padding 12
yabai -m config window_gap 15

# -- mouse settings --

# center mouse on window with focus
# yabai -m config mouse_follows_focus on

# modifier for clicking and dragging with mouse
yabai -m config mouse_modifier alt
# set modifier + left-click drag to move window
yabai -m config mouse_action1 move
# set modifier + right-click drag to resize window
yabai -m config mouse_action2 resize

# when window is dropped in center of another window, swap them (on edges it will split it)
yabai -m mouse_drop_action swap

# Window opacity (default:off)
# example: render all unfocused window with 90% opacity
# yabai -m config window_opacity on
yabai -m config active_window_opacity 0.0
yabai -m config normal_window_opacity 5.0

# yabai -m config window_border on
# yabai -m config window_border_width 7
# yabai -m config active_window_border_color 0xff046307
# yabai -m config normal_window_border_color 0xff555555

# disable specific apps
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^App Store$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Karabiner-Elements$" manage=off
yabai -m rule --add app="^QuickTime Player$" manage=off
yabai -m rule --add app="^Raycast$" manage=off
yabai -m rule --add app="^NTFS for Mac$" manage=off
yabai -m rule --add app="^zoom.us$" manage=off
yabai -m rule --add app="^Speedtest$" manage=off
