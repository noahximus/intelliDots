# mac-essentials: the macOS desktop itself -- window management, menu bar,
# and the applications used on every Mac regardless of whether it is a
# development machine.
#
# tg-pro is deliberately absent: it is appended at install time only on a
# Mac that actually has fans. See machine_has_fans() in install.sh and the
# guarded block in essentialDots/scripts/macos-defaults.sh.

tap "felixkratz/formulae" # Extra formulae used by macOS UI tools like borders.
tap "nikitabobko/tap"     # Official tap for the AeroSpace window manager cask.

brew "borders"         # Draws window borders that pair well with AeroSpace.
cask "aerospace"       # Tiling window manager for macOS.
cask "stats"           # Menu-bar system monitor (CPU, GPU, RAM, disk, network).
cask "jordanbaird-ice" # Menu-bar overflow management.
cask "appcleaner"      # Leftover-free application removal.

cask "google-chrome"    # Web browser.
cask "google-drive"     # Google Drive sync client.
cask "microsoft-office" # Word, Excel, PowerPoint, Outlook -- and OneDrive, bundled.
cask "obsidian"         # Markdown knowledge base and note-taking app.
cask "spotify"          # Music and podcast streaming app.
cask "whatsapp"         # WhatsApp desktop messaging app.
cask "viber"            # Viber desktop messaging and calling app.
