# ai-essentials: the AI assistants used day to day. Light enough to belong
# on any machine, including one that installs no development tier at all.

cask "claude"      # Anthropic's official Claude desktop app.
cask "claude-code" # Anthropic's official Claude Code CLI app.
cask "chatgpt"     # OpenAI's official ChatGPT desktop app.
brew "opencode"    # Terminal coding agent; bridges to nvim via toggleterm.
