# ai-extras: additional assistants and the local-model runtimes.
#
# TurboFieldfare is not here -- it stays behind localLLM's own
# --with-turbo-fieldfare option, since it needs macOS 26, Xcode 26, Apple
# Silicon, and roughly 14GB of model weights.

brew "gemini-cli" # Google's Gemini command-line AI assistant.
brew "llama.cpp"  # Local model runtime used by the localLLM component.
brew "aider"      # Terminal pair-programming agent.

cask "antigravity" # Google's AI-powered development environment.
cask "ollama-app"  # Local model runner.
cask "lm-studio"   # GUI local model runner and model browser.
