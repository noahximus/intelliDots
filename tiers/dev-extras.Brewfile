# dev-extras: additional development tooling that nothing in these dotfiles
# depends on -- the file manager, the git history tool, and the CLI tools that
# earn their place rather than merely improving on a working one.
#
# An alternate IDE, the domain libraries, database and API GUIs, and the
# ps/wc/benchmark replacements all live in optional.Brewfile: this setup
# declares no need for them.

brew "superfile"       # Terminal file manager.
brew "git-filter-repo" # Rewrites git history; the supported filter-branch.
brew "dust"            # Disk usage tree; du replacement.
brew "tldr"            # Practical, example-first command summaries.
